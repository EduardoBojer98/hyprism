#!/usr/bin/env bash
# Hyprland plugins: this repo's own (plugins/<name>/main.cpp) and the official ones listed in UPSTREAM
# (hyprwm/hyprland-plugins). A plugin only loads into the exact Hyprland version it was built against.
#
#   hypr-plugins          load the plugins built for the running Hyprland (run at login). Builds this repo's
#                         own plugins when stale. Never downloads: if the official ones aren't built, it says so.
#   hypr-plugins build    download the newest hyprland-plugins release for the running Hyprland (its own tag,
#                         or the newest earlier one of the same 0.X series when upstream has not tagged the
#                         patch release), compile and load. ./install.sh update runs it; login never downloads.
#
# Both modes end by calling setup_plugins() (hypr/modules/plugins.lua), which configures what got loaded.
set -uo pipefail # no -e: a failed build only skips that plugin
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
case ${1:-} in -h | --help) usage ;; "" | build) ;; *) usage 2 >&2 ;; esac
mode=${1:-load}
repo=$(repo_root) # ~/.local/bin is a link into the repo
out=${XDG_DATA_HOME:-$HOME/.local/share}/hypr-plugins
mkdir -p "$out"
UPSTREAM=(hyprbars) # title bars with buttons for windows that draw none (hypr/modules/plugins.lua)
URL=https://github.com/hyprwm/hyprland-plugins

# release_for TAG: the newest hyprland-plugins tag of TAG's 0.X series that is not newer than TAG
release_for() {
    local t
    git ls-remote --tags --refs "$URL" "${1%.*}.*" | sed 's#.*refs/tags/##' | while read -r t; do
        [[ $(printf '%s\n' "$t" "$1" | sort -V | tail -1) == "$1" ]] && echo "$t"
    done | sort -V | tail -1
}

# load NAME: load a built plugin that is newer than the running Hyprland, unless it is loaded already
load() {
    local so=$out/$1.so
    [[ -f $so && ! /usr/bin/Hyprland -nt $so ]] || return 1
    hyprctl plugin list | grep -q "^Plugin $1 " || hyprctl plugin load "$so" >/dev/null
}

# build NAME SOURCES... : g++ into $out/NAME.so when missing or older than its sources or Hyprland
build() {
    local name=$1 so=$out/$1.so
    shift
    local f stale=false
    [[ ! -f $so || /usr/bin/Hyprland -nt $so ]] && stale=true
    for f in "$@"; do [[ $f -nt $so ]] && stale=true; done
    if $stale; then
        # shellcheck disable=SC2046  # pkg-config prints several flags
        if ! g++ -shared -fPIC -O2 -std=c++2b -Wno-c++11-narrowing -fno-gnu-unique "$@" -o "$so.tmp" \
            $(pkg-config --cflags hyprland pixman-1 libdrm libinput libudev wayland-server xkbcommon) 2>"$out/$name.log"; then
            notify-send -a Hyprland "Plugin $name didn't build" "See $out/$name.log"
            return
        fi
        mv "$so.tmp" "$so"
        hyprctl plugin unload "$so" >/dev/null 2>&1
    fi
    hyprctl plugin list | grep -q "^Plugin $name " || hyprctl plugin load "$so" >/dev/null
}

for src in "$repo"/plugins/*/main.cpp; do
    build "$(basename "$(dirname "$src")")" "$src"
done

tag=$(hyprctl version -j | jq -r .tag)
if [[ $mode == build ]]; then
    rel=$(release_for "$tag")
    [[ -n $rel ]] || die "hyprland-plugins has no ${tag%.*} release yet (or offline): title-bar buttons stay off until it does"
    up=$out/src/hyprland-plugins-$rel
    if [[ ! -d $up ]]; then
        git clone -q -c advice.detachedHead=false -b "$rel" --depth 1 "$URL" "$up" 2>"$out/clone.log" ||
            die "could not download hyprland-plugins $rel; see $out/clone.log"
    fi
    for name in "${UPSTREAM[@]}"; do
        [[ -d $up/$name ]] && build "$name" "$up/$name"/*.cpp
    done
else
    loaded=false
    for name in "${UPSTREAM[@]}"; do load "$name" && loaded=true; done
    $loaded || notify-send -a Hyprland "Title-bar buttons are off" "Run hypr-plugins build (or ./install.sh update) to build them for Hyprland $tag"
fi

hyprctl eval "setup_plugins()" >/dev/null
