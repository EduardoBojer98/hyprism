#!/usr/bin/env bash
# Laptop panel events (lid, 2-in-1 tablet mode), called by the switch binds in hypr/modules/binds.lua.
#
#   panel tablet on|off   360° hinge: auto-rotate panel + touch + stylus (the on-screen
#                         keyboard is only shown from its button in the bar)
#   panel lid close|open  lid: hand everything to the Acer, or suspend if the Acer isn't ours
#   panel rotate          (internal) follow the accelerometer until killed
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/hyprism/common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/hyprism/common.sh"
case ${1:-} in -h | --help) usage ;; esac

rotate() { hyprctl eval "laptop_panel($1)" >/dev/null; } # function from hypr/modules/monitors.lua
# the laptop's own panel (eDP-1, eDP-2…) and whether another screen is showing this desktop
internal() { hyprctl -j monitors all | jq -r '[.[] | select(.name | startswith("eDP"))][0].name // empty'; }
other_active() { hyprctl -j monitors | jq -e --arg i "$1" 'any(.[]; .name != $i)' >/dev/null; }

case "${1:-} ${2:-}" in
    "tablet on")
        pkill -f "panel rotate" || true
        setsid -f "$0" rotate
        qs ipc call tablet set true >/dev/null 2>&1 || true # finger-sized controls in the shell
        ;;
    "tablet off")
        qs ipc call tablet set false >/dev/null 2>&1 || true
        pkill -f "panel rotate" || true
        pkill -x monitor-sensor || true
        rotate 0
        ;;
    "rotate ")
        monitor-sensor | while read -r line; do
            case $line in
                *"orientation: normal"* | *"orientation changed: normal"*) rotate 0 ;;
                *"orientation: left-up"* | *"orientation changed: left-up"*) rotate 1 ;;
                *"orientation: bottom-up"* | *"orientation changed: bottom-up"*) rotate 2 ;;
                *"orientation: right-up"* | *"orientation changed: right-up"*) rotate 3 ;;
            esac
        done
        ;;
    "lid close")
        # With no other screen logind suspends by itself. With one plugged in logind ignores the lid
        # (docked), so: keep working on the other screen if it shows this desktop, otherwise sleep.
        lap=$(internal)
        if [[ -n $lap ]] && other_active "$lap"; then
            hyprctl eval "hl.monitor({ output = \"$lap\", disabled = true })" >/dev/null
        elif grep -qx connected /sys/class/drm/card*-{HDMI,DP}-*/status 2>/dev/null; then
            systemctl suspend-then-hibernate 2>/dev/null || systemctl suspend # plain sleep where hibernation isn't set up
        fi
        ;;
    "lid open")
        rotate 0
        ;;
    *)
        usage 2 >&2
        ;;
esac
