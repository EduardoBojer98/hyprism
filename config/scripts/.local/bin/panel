#!/usr/bin/env bash
# Laptop panel events for the Flow X13, called by the switch binds in hypr/modules/binds.lua.
#
#   panel tablet on|off   360° hinge: auto-rotate panel + touch + stylus (the on-screen
#                         keyboard is only shown from its button in the bar)
#   panel lid close|open  lid: hand everything to the Acer, or suspend if the Acer isn't ours
#   panel rotate          (internal) follow the accelerometer until killed
set -euo pipefail

rotate() { hyprctl eval "laptop_panel($1)" >/dev/null; }  # function from hypr/modules/monitors.lua
acer_is_ours() { hyprctl -j monitors | jq -e 'any(.[]; .name == "HDMI-A-1")' >/dev/null; }

case "${1:-} ${2:-}" in
    "tablet on")
        pkill -f "panel rotate" || true
        setsid -f "$0" rotate
        ;;
    "tablet off")
        pkill -f "panel rotate" || true
        pkill -x monitor-sensor || true
        rotate 0
        ;;
    "rotate ")
        monitor-sensor | while read -r line; do
            case $line in
                *"orientation: normal"*|*"orientation changed: normal"*)    rotate 0 ;;
                *"orientation: left-up"*|*"orientation changed: left-up"*)   rotate 1 ;;
                *"orientation: bottom-up"*|*"orientation changed: bottom-up"*) rotate 2 ;;
                *"orientation: right-up"*|*"orientation changed: right-up"*)  rotate 3 ;;
            esac
        done
        ;;
    "lid close")
        # Without the Acer cable logind suspends by itself. With it plugged in logind ignores
        # the lid, so: keep working on the Acer if it's ours, otherwise sleep.
        if acer_is_ours; then
            hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })' >/dev/null
        elif grep -qx connected /sys/class/drm/card*-HDMI-A-1/status; then
            systemctl suspend-then-hibernate
        fi
        ;;
    "lid open")
        rotate 0
        ;;
    *) echo "usage: panel tablet on|off | panel lid close|open" >&2; exit 2 ;;
esac
