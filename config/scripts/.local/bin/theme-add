#!/usr/bin/env bash
# Add an icon or cursor theme for this user (Settings > Appearance > Icons / Cursor, "Add theme…").
#
#   theme-add icons   FILE-OR-FOLDER    e.g. a .tar.gz / .tar.xz / .zip from a theme site, or a folder
#   theme-add cursors FILE-OR-FOLDER
#
# Copies every theme found inside (a folder with index.theme; cursor themes also have cursors/) to
# ~/.local/share/icons/<name>, replacing an older copy there. Prints the names it added.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/hyprism/common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/hyprism/common.sh"
case ${1:-} in -h | --help) usage ;; esac
kind=${1:-}
src=${2:-}
[[ $kind == icons || $kind == cursors ]] && [[ -n $src ]] || {
    usage 2 >&2
}
[[ -e $src ]] || die "not found: $src"
dest=${XDG_DATA_HOME:-$HOME/.local/share}/icons
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if [[ -d $src ]]; then
    cp -a -- "$src" "$tmp/"
else
    # bsdtar reads tar (any compression) and zip; it drops absolute paths and ".." by default
    bsdtar -xf "$src" -C "$tmp" --no-same-owner || die "can't unpack $src"
fi

added=()
while IFS= read -r -d '' index; do
    theme=$(dirname "$index")
    name=$(basename "$theme")
    has_cursors=false
    [[ -d $theme/cursors ]] && has_cursors=true
    if [[ $kind == cursors ]]; then $has_cursors || continue; else ! $has_cursors || continue; fi
    [[ $name =~ ^[A-Za-z0-9._+-][A-Za-z0-9._+\ -]*$ ]] || continue # a plain folder name, nothing odd
    mkdir -p "$dest"
    rm -rf -- "${dest:?}/$name"
    cp -a -- "$theme" "$dest/$name"
    added+=("$name")
done < <(find "$tmp" -mindepth 1 -maxdepth 4 -name index.theme -print0)

((${#added[@]})) || die "no $kind theme in $src"
# GTK caches icon lookups per theme; refresh it when the tool is there (it isn't for cursor themes)
[[ $kind == icons ]] && command -v gtk-update-icon-cache >/dev/null && for n in "${added[@]}"; do gtk-update-icon-cache -qf "$dest/$n" 2>/dev/null || true; done
printf '%s\n' "${added[@]}"
