#!/usr/bin/env bash
# Websites as apps: a launcher entry that opens the site in its own window, without browser chrome
# (Chrome/Chromium --app). Handy for localhost dev servers, dashboards, mail, admin panels.
#   webapp add "Shop admin" https://admin.shopify.com     then find it in Spotlight like any app
#   webapp list                                             webapp remove "Shop admin"
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/hyprism/common.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/hyprism/common.sh"
case ${1:-} in -h | --help) usage ;; esac
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
slug() {
    local s
    s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//')
    printf '%s' "${s:-app$(printf '%s' "$1" | md5sum | cut -c1-8)}"
}
browser=$(command -v google-chrome-stable || command -v chromium || command -v brave || true)

case ${1:-list} in
    add)
        [[ $# -eq 3 ]] || {
            usage 2 >&2
        }
        # what goes into the launcher entry: one line of name, a URL without spaces, quotes or % (field codes)
        [[ $3 =~ ^https?://[^[:space:]\"\'%\\]+$ ]] || {
            echo "webapp: the address must start with http(s):// and have no spaces, quotes or %" >&2
            exit 2
        }
        [[ $2 != *$'\n'* && -n ${2// /} ]] || {
            echo "webapp: the name must be one line" >&2
            exit 2
        }
        [[ -n $browser ]] || die "needs Chrome, Chromium or Brave (Firefox has no app windows)"
        s=$(slug "$2")
        mkdir -p "$apps"
        [[ ! -e $apps/webapp-$s.desktop ]] || die "'$2' exists already (webapp remove it first)"
        cat >"$apps/webapp-$s.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=$2
Comment=Web app: $3
Exec=$browser "--app=$3" --class=webapp-$s
Icon=web-browser
StartupWMClass=webapp-$s
Categories=Network;WebBrowser;
X-LinuxSetup-WebApp=true
DESK
        echo "webapp: added $2 (Spotlight finds it now)"
        ;;
    remove)
        [[ $# -eq 2 ]] || {
            usage 2 >&2
        }
        rm -v -- "$apps/webapp-$(slug "$2").desktop"
        ;;
    list)
        grep -l '^X-LinuxSetup-WebApp=true' "$apps"/webapp-*.desktop 2>/dev/null | while read -r f; do
            printf '%-24s %s\n' "$(sed -n 's/^Name=//p' "$f")" "$(sed -n 's/^Comment=Web app: //p' "$f")"
        done
        ;;
    *)
        usage 2 >&2
        ;;
esac
