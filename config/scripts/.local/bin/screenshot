#!/usr/bin/env bash
# Screenshots: grim captures, slurp picks, Satty annotates. Wayland-native, works across both monitors at
# different scales (grim captures at the sharpest scale of the screens it covers).
#
#   screenshot [area]     the screen freezes; drag an area or click a window -> editor
#   screenshot screen     the monitor under the mouse          -> editor
#   screenshot window     the screen freezes; click a window   -> editor
#   screenshot all        every monitor                        -> editor
#   screenshot delay [N]  wait N seconds (default 5), then the monitor under the mouse -> editor
#                         (for menus and tooltips: open them during the countdown, crop in the editor)
#   screenshot pin [area] pick an area and keep it floating on top of the screen (no editor, no file in Pictures);
#                         on the pin: drag moves it, scroll zooms, middle or double click closes, right click copies
#   --edit | --copy | --save   what happens after (default: Settings > Screenshots, "edit"): annotate in Satty,
#                         clipboard only, or save to the folder and copy
#   --delay N             wait N seconds first, to open a menu (default: Settings, 0) (default: Settings, 0)
#
# Settings (Config.capture in ~/.config/quickshell/settings.json): folder, after, delay, notify.
# In the editor (Satty): Enter copies and saves, Ctrl+S saves, Ctrl+C copies, Esc cancels,
# Ctrl+Z / Ctrl+Y undo / redo. Tools and colours: config/satty/.config/satty/config.toml.
# Files: <folder>/Screenshot_YYYY-MM-DD_HH-MM-SS.png. A notification with the picture follows; click it to open it
# ("Show folder" opens the folder).
set -euo pipefail
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
case ${1:-} in -h | --help) usage ;; esac

# shellcheck source=config/scripts/.local/lib/hyprism/capture.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/capture.sh"

dir=$(folder folder "$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots")
file="$dir/Screenshot_$(date +%F_%H-%M-%S).png"
tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"; pick_done' EXIT

mode=area
delay=$(cap delay)
delay=${delay:-0}
after=$(cap after)
after=${after:-edit}
quiet=$([[ $(cap notify) == false ]] && echo true || echo false)
for ((i = 1; i <= $#; i++)); do
    a=${!i}
    case $a in
        --edit) after=edit ;;
        --copy) after=copy ;;
        --save) after=save ;;
        --delay) i=$((i + 1)) delay=${!i:-0} ;;
        area) [[ $mode == pin ]] || mode=area ;; # `pin area` is `pin`
        screen | window | all | delay | pin) mode=$a ;;
        *)
            if [[ $a =~ ^[0-9]+$ ]]; then
                [[ $mode == delay ]] && delay=$a
            else
                echo "screenshot: unknown option '$a'" >&2
                usage 2 >&2
            fi
            ;;
    esac
done
[[ $mode == delay && $delay == 0 ]] && delay=5
[[ $after =~ ^(edit|copy|save)$ ]] || after=edit
[[ $delay =~ ^[0-9]+$ ]] || delay=0
fail() {
    notify-send -a Screenshot -u critical "Screenshot failed" "$1"
    exit 1
}
countdown() {
    local i
    for ((i = delay; i > 0; i--)); do
        notify-send -a Screenshot -t 700 -h string:x-canonical-private-synchronous:screenshot "Screenshot in $i…"
        sleep 1
    done
    ((delay > 0)) && sleep 0.3 # let the last countdown bubble fade out of the shot
    return 0
}

# Output name under the mouse, else the focused one. Rotated by 90/270 (tablet mode) = width/height swap.
monitor_under_mouse() {
    local x y
    IFS=', ' read -r x y < <(hyprctl cursorpos)
    hyprctl -j monitors | jq -r --argjson x "${x%.*}" --argjson y "${y%.*}" '
        (map(. as $m | ($m.transform % 2 == 1) as $r
            | select($x >= $m.x and $y >= $m.y
                     and $x < $m.x + ((if $r then $m.height else $m.width end) / $m.scale)
                     and $y < $m.y + ((if $r then $m.width else $m.height end) / $m.scale)))
         + map(select(.focused)))[0].name // empty'
}

case $mode in
    area)
        countdown
        # the screen is frozen; the freeze is lifted after grim has taken the picture. Esc or a right click cancels.
        pick || exit 0
        geo=$PICKED
        grim -g "$geo" "$tmp" || fail "grim couldn't capture that selection"
        pick_done
        ;;
    pin)
        pick || exit 0
        geo=$PICKED
        pins="${XDG_RUNTIME_DIR:?}/hyprism-pins"
        mkdir -p "$pins"
        chmod 700 "$pins"
        pinfile=$(mktemp -p "$pins" pin-XXXXXX.png)
        grim -g "$geo" "$pinfile" || {
            rm -f "$pinfile"
            fail "grim couldn't capture that selection"
        }
        pick_done
        # slurp prints "x,y WxH" in layout coordinates: the shell puts the pin exactly there
        IFS=', x' read -r px py pw ph <<<"$geo"
        qs ipc call pins add "$pinfile" "$px" "$py" "$pw" "$ph" || fail "the shell could not show the pin"
        exit 0
        ;;
    screen | delay)
        countdown
        grim -o "$(monitor_under_mouse)" "$tmp" || fail "grim couldn't capture the screen"
        ;;
    window)
        countdown
        pick windows || exit 0 # click a window
        grim -g "$PICKED" "$tmp" || fail "grim couldn't capture that window"
        pick_done
        ;;
    all)
        countdown
        grim "$tmp" || fail "grim couldn't capture the screens"
        ;;
esac

shown=$file
case $after in
    copy) # clipboard only: no file in the folder; the notification shows a copy kept in the runtime dir
        shown="${XDG_RUNTIME_DIR:-/tmp}/hyprism-last-screenshot.png"
        cp "$tmp" "$shown"
        wl-copy --type image/png <"$shown"
        ;;
    save)
        cp "$tmp" "$file"
        wl-copy --type image/png <"$file"
        ;;
    edit)
        # Satty writes $file only if you save (Enter or Ctrl+S); Esc leaves nothing behind
        satty --filename "$tmp" --output-filename "$file" \
            --actions-on-enter save-to-clipboard,save-to-file,exit --actions-on-escape exit \
            --copy-command wl-copy --disable-notifications --no-window-decoration --initial-tool arrow || true
        ;;
esac

# A notification with the picture; clicking it opens the picture. Runs on after this script exits.
if [[ -f $shown ]] && ! $quiet; then
    (
        action=$(notify-send -a Screenshot -i "$shown" -h "string:image-path:$shown" \
            -A default=Open -A folder="Show folder" "$([[ $after == copy ]] && echo "Screenshot copied" || echo "Screenshot saved")" "${shown/#$HOME/\~}" --wait || true)
        case $action in
            default) xdg-open "$shown" ;;
            folder) xdg-open "$dir" ;;
        esac
    ) >/dev/null 2>&1 &
    disown
fi
