#!/usr/bin/env bash
# Screenshots: grim captures, slurp picks the area, Satty annotates. Wayland-native, works across
# both monitors at different scales (grim captures at the sharpest scale of the screens it covers).
#
#   screenshot [area]     pick an area (drag; touch works too) -> editor
#   screenshot screen     the monitor under the mouse          -> editor
#   screenshot window     the focused window                   -> editor
#   screenshot all        every monitor                        -> editor
#   screenshot delay [N]  wait N seconds (default 5), then the monitor under the mouse -> editor
#                         (for menus and tooltips: open them during the countdown, crop in the editor)
#   add --copy to any of these to skip the editor: copied and saved straight away
#
# In the editor (Satty): Enter copies and saves, Ctrl+S saves, Ctrl+C copies, Esc cancels,
# Ctrl+Z / Ctrl+Y undo / redo. Tools and colours: config/satty/.config/satty/config.toml.
# Files: ~/Pictures/Screenshots/Screenshot_YYYY-MM-DD_HH-MM-SS.png. A notification with a preview
# follows; click it to open the picture ("Show folder" opens the folder).
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%F_%H-%M-%S).png"
tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

mode=${1:-area}; shift || true
delay=5; copy=false
for a in "$@"; do
    case $a in
        --copy) copy=true ;;
        [0-9]*) delay=$a ;;
        *) echo "screenshot: unknown option '$a'" >&2; exit 2 ;;
    esac
done

# selection colours follow the desktop theme (accent from Settings > Appearance)
accent=$(grep -oE 'accent = "[0-9a-fA-F]{6}"' "$HOME/.config/hypr/settings/theme.lua" 2>/dev/null | grep -oE '[0-9a-fA-F]{6}' || echo e4ff1a)

monitor_under_mouse() {
    local x y
    IFS=', ' read -r x y < <(hyprctl cursorpos)
    hyprctl -j monitors | jq -r --argjson x "${x%.*}" --argjson y "${y%.*}" '.[]
        | select($x >= .x and $y >= .y and $x < .x + (.width / .scale) and $y < .y + (.height / .scale)) | .name' | head -1
}

case $mode in
    area)
        # slurp -d shows the size while dragging; Esc or a right click cancels (exit quietly)
        geo=$(slurp -d -c "${accent}ff" -b 0b0d0a66 -s "${accent}1f" -w 2 -B 00000000) || exit 0
        grim -g "$geo" "$tmp" ;;
    screen) grim -o "$(monitor_under_mouse)" "$tmp" ;;
    window)
        geo=$(hyprctl -j activewindow | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end')
        [[ -n $geo ]] || { notify-send -a Screenshot "No focused window to capture"; exit 1; }
        grim -g "$geo" "$tmp" ;;
    all)    grim "$tmp" ;;
    delay)
        for ((i = delay; i > 0; i--)); do
            notify-send -a Screenshot -t 900 -h string:x-canonical-private-synchronous:screenshot "Screenshot in $i…"
            sleep 1
        done
        grim -o "$(monitor_under_mouse)" "$tmp" ;;
    *) sed -n '4,12p' "$0" >&2; exit 2 ;;
esac

if $copy; then
    cp "$tmp" "$file"
    wl-copy --type image/png <"$file"
else
    # Satty writes $file only if you save (Enter or Ctrl+S); Esc leaves nothing behind
    satty --filename "$tmp" --output-filename "$file" \
        --actions-on-enter save-to-clipboard,save-to-file,exit --actions-on-escape exit \
        --copy-command wl-copy --disable-notifications --no-window-decoration --initial-tool arrow || true
fi

# A preview notification; clicking it opens the picture. Runs on after this script exits.
if [[ -f $file ]]; then
    (
        action=$(notify-send -a Screenshot -i "$file" -h "string:image-path:$file" \
            -A default=Open -A folder="Show folder" "Screenshot saved and copied" "${file/#$HOME/\~}" --wait || true)
        case $action in
            default) xdg-open "$file" ;;
            folder)  xdg-open "$dir" ;;
        esac
    ) >/dev/null 2>&1 &
    disown
fi
