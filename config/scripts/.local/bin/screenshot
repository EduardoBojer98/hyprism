#!/usr/bin/env bash
# Screenshots with Flameshot (Print, Shift+Print, Control Center, Spotlight, utility menu).
#   screenshot [area]   pick an area on the screen under the mouse, annotate; Enter copies (and saves), Ctrl+S saves, Esc cancels
#   screenshot all      every screen, copied and saved
# Files go to ~/Pictures/Screenshots. The first run writes Flameshot's settings if it has none;
# after that, change them in Flameshot's own settings (flameshot config).
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/flameshot/flameshot.ini"
mkdir -p "$dir"

if [[ ! -f "$conf" ]]; then
    mkdir -p "${conf%/*}"
    cat >"$conf" <<EOF
[General]
savePath=$dir
savePathFixed=true
saveAsFileExtension=png
filenamePattern=Screenshot_%F_%H-%M-%S
saveAfterCopy=true
copyOnDoubleClick=true
showHelp=false
showStartupLaunchMessage=false
showDesktopNotification=true
showAbortNotification=false
disabledTrayIcon=true
uiColor=#007aff
contrastUiColor=#ffffff
EOF
fi

# Run under Flameshot's own app id so the screenshot permission prompt (once) names Flameshot
run() {
    if command -v systemd-run >/dev/null; then
        systemd-run --user --scope --quiet --collect --unit="app-org.flameshot.Flameshot-$$" flameshot "$@"
    else
        flameshot "$@"
    fi
}

# The overlay opens as a screen-sized window under the bar; make it fullscreen once it appears
cover() {
    local addr=""
    for _ in {1..60}; do
        addr=$(hyprctl -j clients | jq -r '.[] | select(.class == "flameshot" and .title == "flameshot") | .address' | head -1)
        [[ -n "$addr" ]] && break
        sleep 0.05
    done
    [[ -n "$addr" ]] && hyprctl dispatch "hl.dsp.window.fullscreen({ action = \"set\", window = \"address:$addr\" })" >/dev/null
    return 0
}

# The screen under the mouse. Flameshot 14's `gui` asks "which monitor?" when there are two, and
# under XWayland it crops the wrong part of the desktop, so: Wayland, one screen by number.
# shortcut: Flameshot numbers screens in Hyprland's monitor id order; fine until ids get reused oddly after hotplug.
mouse_screen() {
    local x y
    IFS=', ' read -r x y < <(hyprctl cursorpos)
    hyprctl -j monitors | jq -r --argjson x "${x%.*}" --argjson y "${y%.*}" '
        sort_by(.id) | to_entries[] | .value as $m
        | select($x >= $m.x and $y >= $m.y and $x < $m.x + ($m.width / $m.scale) and $y < $m.y + ($m.height / $m.scale))
        | "\(.key) \($m.name)"' | head -1
}

case "${1:-area}" in
    area)
        read -r n name < <(mouse_screen) || { n=0; name=""; }
        # the overlay opens on the focused monitor; make that the one under the mouse
        [[ -n $name ]] && hyprctl dispatch "hl.dsp.focus({ monitor = \"$name\" })" >/dev/null
        run screen -n "$n" -e & cover; wait ;;
    all)    run full --clipboard ;;   # saved too: saveAfterCopy in flameshot.ini
    *)      echo "usage: screenshot [area|all]" >&2; exit 2 ;;
esac
