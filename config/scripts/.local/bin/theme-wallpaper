#!/usr/bin/env bash
# Makes a theme's wallpaper (once; later calls reuse it) and prints its path.
#   theme-wallpaper reactor         the theme's own half     -> ~/.cache/hyprism/wallpapers/reactor-v8.png
#   theme-wallpaper reactor-light   its other half ("-light" or "-dark")
#   theme-wallpaper --all           make every one (to look at them)
# A theme folder (~/.config/hyprism/themes/<id> or ~/.local/share/hyprism/themes/<id>) brings either a picture
# named like the wallpaper (reactor.png, reactor-light.jpg…) or wallpaper.sh, a recipe ImageMagick draws on a
# 2560x1600 sheet. The result is scaled to fill the largest connected screen (3840x2400 without Hyprland).
# Bump VERSION after changing a recipe so the cached pictures are made again.
set -euo pipefail
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
case ${1:-} in -h | --help) usage ;; esac
command -v magick >/dev/null || die "needs ImageMagick (magick)"

VERSION=8
out_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/wallpapers"
mkdir -p "$out_dir"
W=2560 H=1600
TW=3840 TH=2400
if size=$(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width * .height) | "\(.width) \(.height)"' 2>/dev/null) && [[ $size =~ ^[0-9]+\ [0-9]+$ ]]; then
    read -r TW TH <<<"$size"
fi

# A theme folder: yours in ~/.config/hyprism/themes first, then the shipped ones
theme_dir() {
    local d
    for d in "${XDG_CONFIG_HOME:-$HOME/.config}/hyprism/themes/$1" "${XDG_DATA_HOME:-$HOME/.local/share}/hyprism/themes/$1"; do
        [[ -f $d/theme.json ]] && {
            echo "$d"
            return 0
        }
    done
    return 1
}

# draw WALL OUT: WALL is a theme's id (its own half) or "<id>-light" / "<id>-dark" (its other half)
draw() {
    local id=$1 out=$2 theme dir
    theme=${id%-light}
    theme=${theme%-dark}
    dir=$(theme_dir "$theme") || return 1
    local pic
    for pic in "$dir/$id".png "$dir/$id".jpg "$dir/$id".jpeg "$dir/$id".webp; do # a picture wins over a recipe
        [[ -f $pic ]] && {
            magick "$pic" "$out"
            return
        }
    done
    [[ -f $dir/wallpaper.sh ]] || return 1
    # shellcheck disable=SC1091  # each theme brings its own recipe
    . "$dir/wallpaper.sh"
    wallpaper "$id" "$out"
}

ids=("$@")
if [[ ${1:-} == --all ]]; then # every theme folder: its own half, and the other one named in theme.json
    ids=()
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/hyprism/themes/*/ "${XDG_CONFIG_HOME:-$HOME/.config}"/hyprism/themes/*/; do
        [[ -f $d/theme.json && $(basename "$d") != _* ]] || continue
        while read -r w; do [[ -n $w ]] && ids+=("$w"); done < <(jq -r '.wall // empty, .alt.wall // empty' "$d/theme.json")
    done
fi
[[ ${#ids[@]} -gt 0 ]] || {
    usage 2 >&2
}
for id in "${ids[@]}"; do
    [[ $id =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
        echo "theme-wallpaper: bad name '$id'" >&2
        exit 2
    }
    out="$out_dir/$id-v$VERSION.png"
    if [[ ! -s $out ]]; then # PNG24: never a banded palette PNG
        draw "$id" "PNG24:$out.tmp.png" || {
            rm -f "$out.tmp.png"
            die "couldn't draw '$id'"
        }
        magick "$out.tmp.png" -resize "${TW}x${TH}^" -gravity center -extent "${TW}x${TH}" "PNG24:$out.tmp.png" || {
            rm -f "$out.tmp.png"
            die "couldn't scale '$id'"
        }
        mv "$out.tmp.png" "$out"
    fi
    echo "$out"
done
