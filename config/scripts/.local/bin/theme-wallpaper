#!/usr/bin/env bash
# Draws a theme's wallpaper with ImageMagick (once; later calls reuse it) and prints its path.
#   theme-wallpaper pebble     -> ~/.local/share/linux-setup/themes/pebble.png
#   theme-wallpaper --all      draw every one (to look at them)
# Each design uses the theme's own colours (Themes.qml) and its fonts; nothing is downloaded.
# 2560x1600 covers both screens here (16:10 laptop, 16:9 Acer; hyprpaper crops to fill).
# Bump VERSION after changing a design so the cached pictures are redrawn.
set -euo pipefail
command -v magick >/dev/null || { echo "theme-wallpaper: needs ImageMagick (magick)" >&2; exit 1; }

VERSION=4
out_dir="${XDG_DATA_HOME:-$HOME/.local/share}/linux-setup/themes"
mkdir -p "$out_dir"
W=2560 H=1600

draw() {
    local id=$1 out=$2
    case $id in
        pebble)   # soft dusk: two blurred colour pools on violet
            magick -size ${W}x${H} xc:'#16141f' \
                -fill '#5a3d74' -draw 'circle 620,420 620,1240' -fill '#2d6b66' -draw 'circle 2040,1260 2040,1980' \
                -fill '#7a4a5f' -draw 'circle 1700,260 1700,620' -resize 25% -blur 0x55 -resize 400% \
                -attenuate 0.12 +noise Gaussian -colorspace sRGB "$out" ;;
        monolith) # near-black, the computer's name set huge and almost invisible in the corner
            magick -size ${W}x${H} xc:'#0b0c0a' -font 'JetBrainsMono-NF-Bold' -pointsize 330 -fill '#141712' \
                -gravity southwest -annotate +80+40 "$(hostname 2>/dev/null || cat /etc/hostname)" "$out" ;;
        console)  # blue-black with faint amber range rings and a horizon
            magick -size ${W}x${H} radial-gradient:'#0f1726'-'#05080f' -fill none -stroke '#ffb00030' -strokewidth 2 \
                -draw 'circle 1820,800 1820,1100' -draw 'circle 1820,800 1820,1400' -draw 'circle 1820,800 1820,1700' \
                -draw 'line 0,800 2560,800' -stroke '#ffb00060' -draw 'line 1820,760 1820,840' "$out" ;;
        poster)   # Bauhaus poster: a red disc and a cobalt bar on charcoal
            magick -size ${W}x${H} xc:'#141414' -fill '#ff3b1f' -draw 'circle 1880,560 1880,1080' \
                -fill '#2d5bff' -draw 'rectangle 0,1180 1500,1360' -fill '#f4f1ea' -draw 'rectangle 1500,1180 1560,1600' "$out" ;;
        glass)    # deep blue with a soft light from above-left
            magick -size ${W}x${H} xc:'#141821' -fill '#3a4a6b' -draw 'circle 760,320 760,1300' \
                -fill '#2b2950' -draw 'circle 2100,1300 2100,1900' -resize 25% -blur 0x65 -resize 400% "$out" ;;
        atlas)    # Swiss: off-white, a red square, black bars on a grid
            magick -size ${W}x${H} xc:'#f2f2f0' -fill '#e30613' -draw 'rectangle 160,160 1040,1040' \
                -fill '#111111' -draw 'rectangle 1200,160 1260,1440' -draw 'rectangle 160,1200 2400,1240' "$out" ;;
        *) echo "theme-wallpaper: unknown design '$id'" >&2; return 2 ;;
    esac
}

ids=("$@")
[[ ${1:-} == --all ]] && ids=(pebble monolith console poster glass atlas)
[[ ${#ids[@]} -gt 0 ]] || { sed -n '2,7p' "$0" >&2; exit 2; }
for id in "${ids[@]}"; do
    [[ $id =~ ^[a-z]+$ ]] || { echo "theme-wallpaper: bad name '$id'" >&2; exit 2; }
    out="$out_dir/$id-v$VERSION.png"
    if [[ ! -s $out ]]; then   # PNG24: never a banded palette PNG
        draw "$id" "PNG24:$out.tmp.png" || { rm -f "$out.tmp.png"; echo "theme-wallpaper: couldn't draw '$id'" >&2; exit 1; }
        mv "$out.tmp.png" "$out"
    fi
    echo "$out"
done
