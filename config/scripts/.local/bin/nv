#!/bin/sh
# Run one app on the NVIDIA GPU:  nv blender
# The Hyprland session hides NVIDIA's EGL driver so the dGPU can sleep; this brings it back for one app.
# The same variables as prime-run (nvidia-prime), so Fedora needs nothing extra
exec env -u __EGL_VENDOR_LIBRARY_FILENAMES __NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only __GLX_VENDOR_LIBRARY_NAME=nvidia "$@"
