#!/usr/bin/env bash
# Switch the whole desktop's colour theme in one step (bar, panels, window borders, lock screen,
# terminal, GTK, launcher, screenshot selection). Same as Settings > Appearance > Theme.
#   theme              list the themes, current one marked
#   theme radioactive  switch (neon themes: radioactive, molten, cyber, acid, synthwave; plus midnight, nord, ...)
# The list of themes lives in ~/.config/quickshell/Theme.qml (Theme.themes).
set -euo pipefail

qs ipc call config get appearance theme >/dev/null 2>&1 || { echo "theme: the shell (Quickshell) isn't running" >&2; exit 1; }
themes=$(grep -oE '^ +[a-z0-9]+: +\{ name:' "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/Theme.qml" | awk -F: '{gsub(/ /,"",$1); print $1}')
current=$(qs ipc call config get appearance theme | tr -d '"')

if [[ $# -eq 0 ]]; then
    for t in $themes; do [[ $t == "$current" ]] && echo "* $t" || echo "  $t"; done
    exit 0
fi
grep -qx -- "$1" <<<"$themes" || { echo "theme: unknown theme '$1' (run 'theme' for the list)" >&2; exit 2; }

# Config.set answers "ok" or the reason it refused (e.g. a theme missing from Config.qml's schema)
set_opt() { local r; r=$(qs ipc call config set appearance "$1" "$2"); [[ $r == ok ]] || { echo "theme: $1 not set: $r" >&2; exit 1; }; }
set_opt theme "\"$1\""
set_opt accent '"theme"'   # use the theme's own accent
case $1 in radioactive|molten|cyber|acid|synthwave) set_opt border '"neon"' ;; esac
echo "theme: $1"
