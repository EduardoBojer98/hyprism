#!/usr/bin/env bash
# Screen recording with wf-recorder: one key starts, the same key (or the bar's red dot) stops.
#   record [screen]    the screen under the mouse        record area   drag an area or click a window (screen frozen)
#   record stop        stop and save                     record status prints "on" or "off"
#   --audio[=none|desktop|mic]  what to record: what you hear (the default output's monitor, bare --audio), the
#                      microphone, or nothing; --mic is --audio=mic. Default: Settings > Screenshots (capture.audio;
#                      the old "both" means desktop: wf-recorder takes one audio device)
#   --delay N          count down N seconds first
# Files: <capture.recordFolder>/Recording_YYYY-MM-DD_HH-MM-SS.mp4 (default ~/Videos/Recordings). GPU encoding when available, else software.
set -euo pipefail
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
# shellcheck source=config/scripts/.local/lib/hyprism/capture.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/capture.sh"
case ${1:-} in -h | --help) usage ;; esac

pidfile="${XDG_RUNTIME_DIR:-/tmp}/record.pid"
dir=$(folder recordFolder "$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Recordings")
trap pick_done EXIT
# shortcut: a pid reused after a crash would look like a running recorder; checked by name too
running() { [[ -f $pidfile ]] && [[ $(ps -o comm= -p "$(cat "$pidfile")" 2>/dev/null) == wf-recorder ]]; }
tell_shell() { qs ipc call recorder recording "$1" >/dev/null 2>&1 || true; }

mode=screen audio=$(cap audio) delay=0
audio=${audio:-none}
for ((i = 1; i <= $#; i++)); do
    a=${!i}
    case $a in
        screen | area | stop | status) mode=$a ;;
        --audio) audio=desktop ;;
        --audio=*) audio=${a#--audio=} ;;
        --mic) audio=mic ;;
        --delay) i=$((i + 1)) delay=${!i:-0} ;;
        *) usage 2 >&2 ;;
    esac
done
[[ $audio == both ]] && audio=desktop # one device only
[[ $delay =~ ^[0-9]+$ ]] || delay=0
case $audio in
    desktop) audio="--audio=$(pactl get-default-sink 2>/dev/null).monitor" ;;
    mic) audio="--audio=$(pactl get-default-source 2>/dev/null)" ;;
    *) audio="" ;;
esac

if [[ $mode == status ]]; then
    running && echo on || echo off
    exit 0
fi
if running || [[ $mode == stop ]]; then
    running && kill -INT "$(cat "$pidfile")" # the watcher below clears the dot once the file is written
    rm -f "$pidfile"
    exit 0
fi
command -v wf-recorder >/dev/null || {
    notify-send -a Recording -u critical "Screen recording needs wf-recorder" "Install it with ./install.sh (packages: wf-recorder)"
    exit 1
}

mkdir -p "$dir"
file="$dir/Recording_$(date +%F_%H-%M-%S).mp4"
case $mode in
    area)
        pick || exit 0
        pick_done # the recorder films the live screen, not the freeze
        target=(-g "$PICKED")
        ;;
    screen)
        IFS=', ' read -r x y < <(hyprctl cursorpos)
        out=$(hyprctl -j monitors | jq -r --argjson x "${x%.*}" --argjson y "${y%.*}" \
            '.[] | select($x >= .x and $y >= .y and $x < .x + (.width / .scale) and $y < .y + (.height / .scale)) | .name' | head -1)
        target=(-o "${out:-$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')}")
        ;;
esac
for ((i = delay; i > 0; i--)); do
    notify-send -a Recording -t 700 -h string:x-canonical-private-synchronous:recording "Recording in $i…"
    sleep 1
done
# hardware encoding through VA-API on the GPU that draws the desktop; software x264 when there is none or it fails to start
soft=(-c libx264 -p preset=veryfast -p crf=23)
node=$(gpu_render_node "$(hw gpu.primary_pci)")
log="${XDG_RUNTIME_DIR:-/tmp}/record.log"
start() { # start RECORDER-CODEC-ARGS...; true when wf-recorder is still running a second later
    # $audio is one --audio=... word, or nothing at all when empty
    # shellcheck disable=SC2086
    setsid wf-recorder "${target[@]}" "$@" $audio -f "$file" >"$log" 2>&1 &
    pid=$!
    echo "$pid" >"$pidfile"
    sleep 1
    kill -0 "$pid" 2>/dev/null
}
started=false
if [[ -n $node ]] && start -c h264_vaapi -d "$node"; then started=true; fi
if ! $started && start "${soft[@]}"; then started=true; fi
if ! $started; then # died at once: wrong codec, no permission, bad output
    rm -f "$pidfile"
    tell_shell false
    notify-send -a Recording -u critical "Recording didn't start" "$(tail -n 2 "$log")"
    exit 1
fi
tell_shell true
notify-send -a Recording -t 2000 "Recording" "Press the same key, or the red dot in the bar, to stop"
# wait for wf-recorder itself to finish writing (it finalises the file after the stop signal)
(
    while kill -0 "$pid" 2>/dev/null; do sleep 0.5; done
    tell_shell false
    if [[ -s $file ]]; then
        a=$(notify-send -a Recording -A default=Open -A folder="Show folder" "Recording saved" "${file/#$HOME/\~}" --wait || true)
        case $a in default) xdg-open "$file" ;; folder) xdg-open "$dir" ;; esac
    else
        notify-send -a Recording -u critical "Recording failed" "$(tail -n 2 "$log")"
    fi
) >/dev/null 2>&1 &
disown
