#!/usr/bin/env bash
# Emoji picker (Super+.): search by name with fuzzel, then type the emoji into the focused app (wtype) and
# leave it on the clipboard.
#   emojipick          open the picker
#   emojipick list     print the list it searches (emoji, name, group), tab-separated
# The list is Unicode's own (the unicode-emoji package), cached as a small table.
set -euo pipefail
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
case ${1:-} in -h | --help) usage ;; esac

data=${EMOJI_DATA:-/usr/share/unicode/emoji/emoji-test.txt}
cache="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/emoji.tsv"
[[ -r $data ]] || die "the emoji list is missing ($data): install the unicode-emoji package (./install.sh --only tools)"

if [[ ! -s $cache || $data -nt $cache ]]; then
    mkdir -p "$(dirname "$cache")"
    # lines look like: "1F600 ; fully-qualified # 😀 E1.0 grinning face", under "# group: Smileys & Emotion"
    awk '
        /^# group: / { group = substr($0, 10); next }
        /; fully-qualified/ {
            rest = substr($0, index($0, "# ") + 2)      # "😀 E1.0 grinning face"
            emoji = substr(rest, 1, index(rest, " ") - 1)
            name = substr(rest, index(rest, " ") + 1)
            sub(/^E[0-9.]+ /, "", name)
            print emoji "\t" name "\t" group
        }' "$data" >"$cache.tmp"
    mv "$cache.tmp" "$cache"
fi

case ${1:-} in
    list)
        cat "$cache"
        exit 0
        ;;
    "") ;;
    *) usage 2 >&2 ;;
esac

choice=$(awk -F'\t' '{ printf "%s  %s  · %s\n", $1, $2, $3 }' "$cache" |
    fuzzel --dmenu --prompt "Emoji  " --width 48 --lines 12) || exit 0
emoji=${choice%%  *}
[[ -n $emoji ]] || exit 0

printf '%s' "$emoji" | wl-copy
command -v wtype >/dev/null && {
    sleep 0.15
    wtype -- "$emoji"
}
