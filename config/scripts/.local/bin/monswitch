#!/usr/bin/env bash
# Switch a monitor shared with another computer (e.g. a work PC) over DDC/CI,
# and move Hyprland workspaces off / back onto it.
#
#   monswitch [toggle] switch to whichever side isn't showing now (keybind / bar button)
#   monswitch pc       give the monitor to the work PC
#   monswitch laptop   take the monitor back
#   monswitch sync     match Hyprland to the monitor's current input, no DDC write (startup, resume)
#   monswitch watch    background loop: follows switches made with the monitor's own buttons
#
# Linux keeps reporting the monitor as connected while it shows the PC, so Hyprland can't
# notice on its own. The DDC input register (VCP 0x60) is the source of truth.
# Setup is ~/.config/monswitch.conf (Settings > Shared Monitor writes it); without it nothing happens.
set -euo pipefail
# shellcheck source=config/scripts/.local/lib/hyprism/common.sh
. "${HYPRISM_LIB:-$HOME/.local/lib/hyprism}/common.sh"
case ${1:-} in -h | --help) usage ;; esac

# Per-computer values live in ~/.config/monswitch.conf (no file = feature off), for example:
#   OUT=HDMI-A-1   # for example: Hyprland output name of the shared monitor
#   LAPTOP=0x11    # monitor input this computer is on (VCP 0x60 value)
#   PC=0x12        # monitor input of the other computer
#   MIRROR=eDP-1   # optional, for example: screen it mirrors while the other computer has it (keeps a signal).
#                  # Default: this computer's built-in screen; none means no mirroring, workspaces stay put
#   MIRROR_MODE=1920x1080@60   # optional: mode used for that mirror
#   POLL=5         # optional: seconds between DDC reads in watch mode (30 while nothing changes and the screen is off)
# Settings > Shared Monitor writes this file. By hand: ddcutil detect; ddcutil getvcp 60
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/monswitch.conf
[[ -f $CONF ]] || {
    echo "monswitch: no $CONF, nothing to do" >&2
    exit 0
}
POLL=5 # seconds between DDC reads in watch mode
# read KEY=value lines (never run the file as shell): only the known keys, only plain values
while IFS='=' read -r key value; do
    case $key in OUT | LAPTOP | PC | MIRROR | MIRROR_MODE | POLL)
        # plain values only, starting with a letter or digit (a leading "-" would reach ddcutil as an option)
        if [[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
            printf -v "$key" '%s' "$value"
        else echo "monswitch: ignored $key in $CONF (not a plain value)" >&2; fi
        ;;
    esac
done <"$CONF"
: "${OUT:?set OUT in $CONF}" "${LAPTOP:?set LAPTOP in $CONF}" "${PC:?set PC in $CONF}"
[[ $POLL =~ ^[1-9][0-9]*$ ]] || POLL=5
MIRROR=${MIRROR-$(hw display.internal)} # "none" in the file = no mirroring
[[ $MIRROR == none ]] && MIRROR=""
MIRROR_MODE=${MIRROR_MODE:-preferred} # your own mode from the file, else whatever the screen prefers

STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/monswitch
SHARED=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/settings/shared.lua # the hand-off, for Hyprland (modules/monitors.lua)
LAYOUT=$STATE_DIR/layout.json
mkdir -p "$STATE_DIR"

# The i2c bus number can change between boots, after a resume or a replug; the DRM connector always
# links to the right one, so it is looked up on every call (watch runs for the whole session).
bus() { readlink -f /sys/class/drm/card*-"$OUT"/ddc 2>/dev/null | sed 's/.*i2c-//' | head -1; }

ddc_input() { # prints 0x11 / 0x12, or nothing when the monitor doesn't answer (common mid-switch, or unplugged)
    local b
    b=$(bus)
    [[ -n $b ]] || return 0
    { ddcutil --bus "$b" getvcp 60 --terse 2>/dev/null || true; } | awk '$1 == "VCP" {sub(/^x/, "0x", $4); print $4}'
}
ddc_set() {
    local b
    b=$(bus)
    [[ -n $b ]] || {
        echo "monswitch: $OUT isn't connected" >&2
        return 1
    }
    ddcutil --bus "$b" setvcp 60 "$1"
}

out_enabled() { hyprctl -j monitors | jq -e --arg o "$OUT" 'any(.[]; .name == $o)' >/dev/null; }

save_layout() {
    jq -n \
        --argjson ws "$(hyprctl -j workspaces | jq --arg o "$OUT" '[.[] | select(.monitor == $o and .id > 0) | .id]')" \
        --argjson active "$(hyprctl -j monitors | jq --arg o "$OUT" '.[] | select(.name == $o) | .activeWorkspace.id')" \
        '{workspaces: $ws, active: $active}' >"$LAYOUT"
}

restore_layout() {
    [[ -f $LAYOUT ]] || return 0
    local id
    for id in $(jq -r '.workspaces[]' "$LAYOUT"); do
        hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"$OUT\" })" >/dev/null
    done
    id=$(jq -r '.active // empty' "$LAYOUT")
    [[ -n $id ]] && hyprctl dispatch "hl.dsp.focus({ workspace = \"$id\" })" >/dev/null
    return 0
}

# Hyprland side only: used directly by the watcher when the input was switched by hand.
# The monitor is mirrored, not disabled: with no signal from this computer some monitors
# give up on the other input within ~5 s. A mirror keeps a signal but holds no workspaces.
release() {
    out_enabled || return 0
    [[ -n $MIRROR ]] || return 0 # no screen to mirror: leave Hyprland as it is
    save_layout
    # kept in a file Hyprland's monitors.lua reads, so a reload or a theme change keeps the hand-off
    local table="{ output = \"$OUT\", mirror = \"$MIRROR\", mode = \"$MIRROR_MODE\" }"
    printf -- '-- Written by monswitch: %s is with the other computer. Removed when it comes back.\nreturn %s\n' "$OUT" "$table" >"$SHARED"
    hyprctl eval "SHARED = $table; apply_displays()" >/dev/null
    local id # a mirror can keep its workspaces, so move them explicitly
    for id in $(jq -r '.workspaces[]' "$LAYOUT"); do
        hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"$MIRROR\" })" >/dev/null
    done
    notify-send -a monswitch "Monitor → other computer" "Workspaces moved to $MIRROR"
}
reclaim() {
    out_enabled && return 0
    rm -f "$SHARED"
    hyprctl eval "SHARED = nil; apply_displays()" >/dev/null # its own monitor rule again (modules/monitors.lua)
    sleep 1
    restore_layout
    notify-send -a monswitch "Monitor → this computer" "Workspaces restored"
}

to_pc() {
    ddc_set "$PC" # switch first, while the laptop still sends a picture
    sleep 2       # the input change causes a ~1 s HDMI disconnect blip; let it pass
    release
}
to_laptop() {
    reclaim # send a picture first, so the monitor has a signal to switch to
    ddc_set "$LAPTOP"
}

# One action at a time: a keypress and the watcher must never interleave.
exec 9>"$STATE_DIR/lock"

case ${1:-toggle} in
    pc)
        flock 9
        to_pc
        ;;
    laptop)
        flock 9
        to_laptop
        ;;
    toggle)
        flock 9
        if out_enabled && [[ $(ddc_input) == "$LAPTOP" ]]; then to_pc; else to_laptop; fi
        ;;
    sync)
        # Align Hyprland to the actual DDC input on startup/resume without sending a DDC write.
        flock 9
        now=$(ddc_input)
        if [[ $now == "$PC" ]]; then
            release || true
        elif [[ $now == "$LAPTOP" ]]; then
            reclaim || true
        fi
        ;;
    watch)
        last="" same=0 interval=$POLL
        while sleep "$interval"; do
            now=$(ddc_input)
            if [[ $now == "$last" ]]; then same=$((same + 1)); else same=0; fi
            # Act only on two identical readings in a row; ignores glitches during a switch.
            if [[ -n $now && $now == "$last" ]]; then
                flock 9
                now=$(ddc_input) # re-read: a keypress may have switched while we waited for the lock
                # || true: one failed hyprctl/notify call must not kill the watcher
                if [[ $now == "$PC" ]]; then
                    release || true
                elif [[ $now == "$LAPTOP" ]]; then
                    reclaim || true
                fi
                flock -u 9
            fi
            last=$now
            # nothing changed for three reads and the screen is off: look less often
            interval=$POLL
            if ((same >= 2)) && ! hyprctl -j monitors | jq -e --arg o "$OUT" 'any(.[]; .name == $o and .dpmsStatus)' >/dev/null; then interval=30; fi
        done
        ;;
    *)
        usage 2 >&2
        ;;
esac
