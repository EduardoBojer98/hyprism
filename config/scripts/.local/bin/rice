#!/usr/bin/env bash
# Switch the whole desktop design in one step: layout, type, shapes, colours, motion, lock screen,
# terminal and wallpaper. Same as Settings > Rices. The rices live in ~/.config/quickshell/Rices.qml.
#   rice            list the rices, the current one marked
#   rice pebble     switch (pebble, monolith, console, workstation, poster, glass, canvas, atlas,
#                   noir, garden, zen, mist, halo)
set -euo pipefail

qs ipc call config get appearance rice >/dev/null 2>&1 || { echo "rice: the shell (Quickshell) isn't running" >&2; exit 1; }
rices=$(grep -oE '^\s+id: "[a-z0-9]+", name: "[^"]+", about: "[^"]+"' "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/Rices.qml" \
    | sed -E 's/^\s+id: "([a-z0-9]+)", name: "([^"]+)", about: "([^"]+)"/\1\t\2\t\3/')
current=$(qs ipc call config get appearance rice | tr -d '"')

if [[ $# -eq 0 ]]; then
    while IFS=$'\t' read -r id name about; do
        printf '%s %-12s %s\n' "$([[ $id == "$current" ]] && echo '*' || echo ' ')" "$id" "$about"
    done <<<"$rices"
    exit 0
fi
cut -f1 <<<"$rices" | grep -qx -- "$1" || { echo "rice: unknown rice '$1' (run 'rice' for the list)" >&2; exit 2; }

# Config.set answers "ok" or the reason it refused
r=$(qs ipc call config set appearance rice "\"$1\"")
[[ $r == ok ]] || { echo "rice: not switched: $r" >&2; exit 1; }
echo "rice: $1"
