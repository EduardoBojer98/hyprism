// Greeting for new fish shells (CachyOS runs fastfetch as fish_greeting; Settings > Appearance > Terminal > Greeting).
// The logo slot takes a random Pokémon with the Pokémon greeting (fish: --file-raw), else the distro's small logo.
// Colours are the terminal's 16, so the card follows the theme's palette. Info column ~34 wide: fits beside a sprite.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "CachyOS_small", "padding": { "top": 1, "left": 1, "right": 3 } },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "title": "bright_white", "separator": "bright_black", "output": "white" },
        "key": { "width": 3 },
        "bar": { "char": { "elapsed": "■", "total": "■" }, "border": { "left": "", "right": "" }, "width": 10 },
        "percent": { "type": 3 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{#90}@{#}{host-name-colored}" },
        { "type": "custom", "format": "{#90}──────────────────────────────" },
        { "type": "os", "key": "\uf303", "keyColor": "blue", "format": "{name}" },
        { "type": "kernel", "key": "\uf013", "keyColor": "cyan", "format": "{release}" },
        { "type": "wm", "key": "\uf2d2", "keyColor": "magenta", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "\uf120", "keyColor": "green", "format": "{pretty-name} {version}" },
        { "type": "uptime", "key": "󰅐", "keyColor": "yellow", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "packages", "key": "󰏖", "keyColor": "red", "format": "{all} packages" },
        "break",
        { "type": "memory", "key": "󰍛", "keyColor": "cyan", "format": "{percentage-bar} {used} / {total}" },
        { "type": "disk", "key": "󰋊", "keyColor": "blue", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
        { "type": "battery", "key": "󰁹", "keyColor": "green", "format": "{capacity-bar} {capacity}" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 4 }
    ]
}
