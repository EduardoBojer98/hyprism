// Greeting for new fish shells (CachyOS runs fastfetch as fish_greeting; Settings > Appearance > Terminal > Greeting).
// A card on a rail: who and where, then system, hardware and usage, the palette at the foot. Colours are the
// terminal's 16, so it follows the theme. The logo slot takes a random Pokémon with the Pokémon greeting
// (scripts/pokemon-card: one box size for all), else the distro's small logo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "CachyOS_small", "padding": { "top": 1, "left": 1, "right": 3 } },
    "display": {
        "separator": " ",
        "color": { "keys": "default", "title": "bright_white", "output": "default" },
        "bar": { "char": { "elapsed": "━", "total": "─" }, "color": { "total": "90" }, "border": { "left": "", "right": "" }, "width": 12 },
        "percent": { "type": 3, "green": 60, "yellow": 85 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{#90}╭─{#} {#1}{user-name}{#}{#90} @ {#}{#1;34}{host-name}{#}" },
        { "type": "custom", "format": "{#90}│" },

        { "type": "os", "key": "{#90}│{#} {#34}{#}  {#90}os     ", "format": "{name}" },
        { "type": "kernel", "key": "{#90}│{#} {#36}{#}  {#90}kernel ", "format": "{release}" },
        { "type": "wm", "key": "{#90}│{#} {#35}{#}  {#90}desktop", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "{#90}│{#} {#32}{#}  {#90}shell  ", "format": "{pretty-name} {version}" },
        { "type": "uptime", "key": "{#90}│{#} {#33}󰅐{#}  {#90}uptime ", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "packages", "key": "{#90}│{#} {#31}󰏖{#}  {#90}apps   ",
          "format": "{?pacman}{pacman} {#90}pacman{#}{?}{?rpm}{rpm} {#90}rpm{#}{?}{?flatpak-all}  {flatpak-all} {#90}flatpak{#}{?}{?snap}  {snap} {#90}snap{#}{?}{?appimage}  {appimage} {#90}appimage{#}{?}" },

        { "type": "custom", "format": "{#90}├─ {#3}hardware" },
        { "type": "host", "key": "{#90}│{#} {#97}{#}  {#90}model  ", "format": "{family}" },
        { "type": "cpu", "key": "{#90}│{#} {#33}{#}  {#90}cpu    ", "format": "{name} {#90}· {cores-logical} threads" },
        { "type": "gpu", "key": "{#90}│{#} {#32}󰢮{#}  {#90}gpu    ", "format": "{name} {#90}· {type}" },
        { "type": "display", "key": "{#90}│{#} {#35}󰍹{#}  {#90}screen ", "format": "{width}×{height} {#90}·{#} {refresh-rate} Hz{?inch} {#90}·{#} {inch}\"{?}" },

        { "type": "custom", "format": "{#90}├─ {#3}usage" },
        { "type": "memory", "key": "{#90}│{#} {#36}󰍛{#}  {#90}memory ", "format": "{percentage-bar} {percentage}  {#90}{used} / {total}" },
        { "type": "disk", "key": "{#90}│{#} {#34}󰋊{#}  {#90}disk   ", "folders": "/", "format": "{size-percentage-bar} {size-percentage}  {#90}{size-used} / {size-total}" },
        { "type": "battery", "key": "{#90}│{#} {#32}󰁹{#}  {#90}battery", "format": "{capacity-bar} {capacity}" },

        { "type": "custom", "format": "{#90}╰─" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 3 }
    ]
}
