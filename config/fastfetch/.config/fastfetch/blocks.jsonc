// Poster's greeting card (theme.json term.prompt "blocks"): config.jsonc on a heavy rail, caps section heads and
// block bars. ThemeSync's greeting passes it with -c while Poster is the theme.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "CachyOS_small", "padding": { "top": 1, "left": 1, "right": 3 } },
    "display": {
        "separator": " ",
        "color": { "keys": "default", "title": "bright_white", "output": "default" },
        "bar": { "char": { "elapsed": "█", "total": "░" }, "color": { "total": "90" }, "border": { "left": "", "right": "" }, "width": 12 },
        "percent": { "type": 3, "green": 60, "yellow": 85 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{#31}┏━{#} {#1}{user-name}{#}{#90} @ {#}{#1;31}{host-name}{#}" },
        { "type": "custom", "format": "{#31}┃" },

        { "type": "os", "key": "{#31}┃{#} {#34}{#}  {#90}os     ", "format": "{name}" },
        { "type": "kernel", "key": "{#31}┃{#} {#36}{#}  {#90}kernel ", "format": "{release}" },
        { "type": "wm", "key": "{#31}┃{#} {#35}{#}  {#90}desktop", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "{#31}┃{#} {#32}{#}  {#90}shell  ", "format": "{pretty-name} {version}" },
        { "type": "uptime", "key": "{#31}┃{#} {#33}󰅐{#}  {#90}uptime ", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "packages", "key": "{#31}┃{#} {#31}󰏖{#}  {#90}apps   ",
          "format": "{?pacman}{pacman} {#90}pacman{#}{?}{?rpm}{rpm} {#90}rpm{#}{?}{?flatpak-all}  {flatpak-all} {#90}flatpak{#}{?}{?snap}  {snap} {#90}snap{#}{?}{?appimage}  {appimage} {#90}appimage{#}{?}" },

        { "type": "custom", "format": "{#31}┣━ {#1}HARDWARE" },
        { "type": "host", "key": "{#31}┃{#} {#97}{#}  {#90}model  ", "format": "{family}" },
        { "type": "cpu", "key": "{#31}┃{#} {#33}{#}  {#90}cpu    ", "format": "{name} {#90}· {cores-logical} threads" },
        { "type": "gpu", "key": "{#31}┃{#} {#32}󰢮{#}  {#90}gpu    ", "format": "{name} {#90}· {type}" },
        { "type": "display", "key": "{#31}┃{#} {#35}󰍹{#}  {#90}screen ", "format": "{width}×{height} {#90}·{#} {refresh-rate} Hz{?inch} {#90}·{#} {inch}\"{?}" },

        { "type": "custom", "format": "{#31}┣━ {#1}USAGE" },
        { "type": "memory", "key": "{#31}┃{#} {#36}󰍛{#}  {#90}memory ", "format": "{percentage-bar} {percentage}  {#90}{used} / {total}" },
        { "type": "disk", "key": "{#31}┃{#} {#34}󰋊{#}  {#90}disk   ", "folders": "/", "format": "{size-percentage-bar} {size-percentage}  {#90}{size-used} / {size-total}" },
        { "type": "battery", "key": "{#31}┃{#} {#32}󰁹{#}  {#90}battery", "format": "{capacity-bar} {capacity}" },

        { "type": "custom", "format": "{#31}┗━" },
        { "type": "colors", "symbol": "block", "paddingLeft": 3 }
    ]
}
