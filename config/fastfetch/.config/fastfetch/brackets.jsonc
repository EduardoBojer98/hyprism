// Monolith's greeting card (theme.json term.prompt "brackets"): config.jsonc as an ascii frame with > bullets and
// bracketed meters. ThemeSync's greeting passes it with -c while Monolith is the theme.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "CachyOS_small", "padding": { "top": 1, "left": 1, "right": 3 } },
    "display": {
        "separator": " ",
        "color": { "keys": "default", "title": "bright_white", "output": "default" },
        "bar": { "char": { "elapsed": "#", "total": "." }, "color": { "total": "90" }, "border": { "left": "[", "right": "]" }, "width": 12 },
        "percent": { "type": 3, "green": 60, "yellow": 85 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{#90}+--[ {#}{#1;32}{user-name}{#}{#90}@{#}{#1;32}{host-name}{#}{#90} ]{#}" },
        { "type": "custom", "format": "{#90}|" },

        { "type": "os", "key": "{#90}|{#} {#32}>{#} {#90}os     ", "format": "{name}" },
        { "type": "kernel", "key": "{#90}|{#} {#32}>{#} {#90}kernel ", "format": "{release}" },
        { "type": "wm", "key": "{#90}|{#} {#32}>{#} {#90}desktop", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "{#90}|{#} {#32}>{#} {#90}shell  ", "format": "{pretty-name} {version}" },
        { "type": "uptime", "key": "{#90}|{#} {#32}>{#} {#90}uptime ", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
        { "type": "packages", "key": "{#90}|{#} {#32}>{#} {#90}apps   ",
          "format": "{?pacman}{pacman} {#90}pacman{#}{?}{?rpm}{rpm} {#90}rpm{#}{?}{?flatpak-all}  {flatpak-all} {#90}flatpak{#}{?}{?snap}  {snap} {#90}snap{#}{?}{?appimage}  {appimage} {#90}appimage{#}{?}" },

        { "type": "custom", "format": "{#90}+-- {#32}hardware{#}{#90} --" },
        { "type": "host", "key": "{#90}|{#} {#32}>{#} {#90}model  ", "format": "{family}" },
        { "type": "cpu", "key": "{#90}|{#} {#32}>{#} {#90}cpu    ", "format": "{name} {#90}· {cores-logical} threads" },
        { "type": "gpu", "key": "{#90}|{#} {#32}>{#} {#90}gpu    ", "format": "{name} {#90}· {type}" },
        { "type": "display", "key": "{#90}|{#} {#32}>{#} {#90}screen ", "format": "{width}×{height} {#90}·{#} {refresh-rate} Hz{?inch} {#90}·{#} {inch}\"{?}" },

        { "type": "custom", "format": "{#90}+-- {#32}usage{#}{#90} --" },
        { "type": "memory", "key": "{#90}|{#} {#32}>{#} {#90}memory ", "format": "{percentage-bar} {percentage}  {#90}{used} / {total}" },
        { "type": "disk", "key": "{#90}|{#} {#32}>{#} {#90}disk   ", "folders": "/", "format": "{size-percentage-bar} {size-percentage}  {#90}{size-used} / {size-total}" },
        { "type": "battery", "key": "{#90}|{#} {#32}>{#} {#90}battery", "format": "{capacity-bar} {capacity}" },

        { "type": "custom", "format": "{#90}+--" },
        { "type": "colors", "symbol": "block", "paddingLeft": 3 }
    ]
}
