# Secrets never go in this repo. Keep them in ~/.config/secrets.env (outside the repo).
*.env
.env*
!*.env.example
*.key
*.pem
id_*

# Per-machine overrides that should stay local (not "*.local": that would hide the .local/ stow dirs)
*.local.lua

# Your own choices from the Settings app live in ~/.config (config/ is linked file by file with
# stow --no-folding), so nothing the app writes lands in this folder. Old installs, just in case:
config/quickshell/.config/quickshell/settings.json
config/hypr/.config/hypr/settings/
config/ghostty/.config/ghostty/theme.conf

# Dev tooling: Graphify's code graph is generated (graphify update .), and its Claude skill is
# installed per machine by `graphify claude install`. Personal Claude permissions stay local.
graphify-out/
.claude/skills/
.claude/settings.local.json
