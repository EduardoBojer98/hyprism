#!/usr/bin/env bash
# Fan curves for the ASUS Settings page, on top of asusctl (asusd does the hardware writes).
#
#   asusfan get                          JSON: {profile: {cpu|gpu: {enabled, temp[8], pct[8]}}}
#   asusfan set PROFILE FAN DATA         DATA = "40c:10%,50c:20%,..." (8 points), validated, enabled
#   asusfan enable PROFILE FAN true|false   both fans of PROFILE (FAN is kept for compatibility)
#   asusfan recommended                  re-apply this computer's system/hosts/<host>/50-power.user.sh
#   asusfan backup                       copy curves + settings to ~/.local/state/asus-backup/<time>/
#   asusfan restore DIR                  put back the curves from a backup DIR
#   asusfan sample                       one line of JSON with temps, power, clocks, load, fans
#
# Only fan curves are touched; firmware thermal protection stays in charge above them.
# Both fans of a mode are always on or off together: with only one curve on, this BIOS (415) left
# the other fan stuck (CPU fan at 0 RPM). asusd also needs the curves on for a mode's power limit.
set -euo pipefail

BACKUPS="${XDG_STATE_HOME:-$HOME/.local/state}/asus-backup"
PROFILES=(Quiet Balanced Performance)

die() { echo "asusfan: $*" >&2; exit 1; }
valid_profile() { [[ " ${PROFILES[*]} " == *" $1 "* ]] || die "unknown profile: $1"; }
valid_fan() { [[ "$1" == cpu || "$1" == gpu ]] || die "unknown fan: $1"; }

# asusctl prints RON; turn one profile's output into {"cpu":{...},"gpu":{...}}
curves_json() {
    asusctl fan-curve --mod-profile "$1" | awk '
        /fan:/     { gsub(/[ ,]/, "", $2); fan = tolower($2) }
        /pwm:/     { gsub(/.*\(|\).*/, ""); pwm[fan] = $0 }
        /temp:/    { gsub(/.*\(|\).*/, ""); temp[fan] = $0 }
        /enabled:/ { gsub(/[ ,]/, "", $2); en[fan] = $2 }
        END {
            printf "{"; sep = ""
            for (f in en) {
                n = split(pwm[f], p, /, */); split(temp[f], t, /, */)
                pct = ""; for (i = 1; i <= n; i++) pct = pct (i > 1 ? "," : "") int(p[i] * 100 / 255 + 0.5)
                tl = ""; for (i = 1; i <= n; i++) tl = tl (i > 1 ? "," : "") t[i]
                printf "%s\"%s\":{\"enabled\":%s,\"temp\":[%s],\"pct\":[%s]}", sep, f, en[f], tl, pct; sep = ","
            }
            printf "}"
        }'
}

get() {
    printf '{'
    local sep=""
    for p in "${PROFILES[@]}"; do printf '%s"%s":%s' "$sep" "$p" "$(curves_json "$p")"; sep=","; done
    printf '}\n'
}

# 8 points, temps 30-100 °C strictly rising, fan 0-100 % never falling, at least 40 % from 85 °C
validate() {
    local data=$1
    awk -v d="$data" 'BEGIN {
        n = split(d, pts, ",")
        if (n != 8) { print "need 8 points, got " n; exit 1 }
        for (i = 1; i <= n; i++) {
            if (pts[i] !~ /^[0-9]+c:[0-9]+%$/) { print "bad point: " pts[i]; exit 1 }
            split(pts[i], kv, /c:|%/); t = kv[1] + 0; p = kv[2] + 0
            if (t < 30 || t > 100) { print "temperature out of 30-100: " t; exit 1 }
            if (p > 100) { print "fan above 100%: " p; exit 1 }
            if (i > 1 && (t < pt || (t == pt && p != pp))) { print "temperatures must rise: " pt " then " t; exit 1 }
            if (i > 1 && p < pp)  { print "fan speed must not drop: " pp "% then " p "%"; exit 1 }
            if (t >= 85 && p < 40) { print "at " t " °C the fan must be at least 40%"; exit 1 }
            pt = t; pp = p
        }
        if (pp < 40) { print "the last point must reach 40% fan"; exit 1 }
    }' || return 1
}

backup() {
    local dir; dir="$BACKUPS/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$dir"
    for p in "${PROFILES[@]}"; do asusctl fan-curve --mod-profile "$p" >"$dir/fan-curve-$p.ron"; done
    asusctl profile get >"$dir/profile.txt" 2>&1 || true
    cp /etc/asusd/*.ron "$dir/" 2>/dev/null || true
    echo "$dir"
}

restore() {
    local dir=$1
    [[ -d "$dir" ]] || die "no backup at $dir (see $BACKUPS)"
    for p in "${PROFILES[@]}"; do
        local f="$dir/fan-curve-$p.ron"; [[ -f "$f" ]] || continue
        awk '/fan:/{gsub(/[ ,]/,"",$2); fan=tolower($2)} /pwm:/{gsub(/.*\(|\).*/,""); pwm=$0}
             /temp:/{gsub(/.*\(|\).*/,""); temp=$0} /enabled:/{gsub(/[ ,]/,"",$2); print fan, $2, temp "|" pwm}' "$f" |
        while read -r fan enabled pts; do
            local temps=${pts%|*} pwms=${pts#*|} data=""
            IFS=', ' read -ra t <<<"$temps"; IFS=', ' read -ra w <<<"$pwms"
            for i in "${!t[@]}"; do data+="${data:+,}${t[$i]}c:${w[$i]}"; done   # no % = raw 0-255
            asusctl fan-curve --mod-profile "$p" --fan "$fan" --data "$data" >/dev/null
            asusctl fan-curve --mod-profile "$p" --fan "$fan" --enable-fan-curve "$enabled" >/dev/null
        done
    done
    echo "restored from $dir"
}

sample() {
    hw() { for h in /sys/class/hwmon/hwmon*; do [[ "$(<"$h/name")" == "$1" ]] && { echo "$h"; return; }; done; }
    local k10 gpu asus
    k10=$(hw k10temp); gpu=$(hw amdgpu); asus=$(hw asus)
    read -r t0 i0 < <(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat)
    sleep 0.5
    read -r t1 i1 < <(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat)
    local dgpu=/sys/bus/pci/devices/0000:01:00.0/power/runtime_status   # read without waking it
    printf '{"cpu":%s,"gpu":%s,"watts":%s,"mhz":%s,"load":%s,"fanCpu":%s,"fanGpu":%s,"profile":"%s","nvidia":"%s"}\n' \
        "$(( $(<"$k10/temp1_input") / 1000 ))" "$(( $(<"$gpu/temp1_input") / 1000 ))" \
        "$(awk '{printf "%.1f", $1/1e6}' "$gpu/power1_input")" \
        "$(awk '{s+=$1; n++} END{printf "%d", s/n/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq)" \
        "$(( (100 * ((t1 - t0) - (i1 - i0))) / ((t1 - t0) > 0 ? (t1 - t0) : 1) ))" \
        "$(<"$asus/fan1_input")" "$(<"$asus/fan2_input")" \
        "$(asusctl profile get 2>/dev/null | awk '/Active profile/{print $3}')" \
        "$(cat "$dgpu" 2>/dev/null || echo unknown)"
}

case "${1:-}" in
    get) get ;;
    set)
        [[ $# -eq 4 ]] || die "usage: asusfan set PROFILE cpu|gpu DATA"
        valid_profile "$2"; valid_fan "$3"
        msg=$(validate "$4") || die "$msg"
        [[ -n "$(ls -A "$BACKUPS" 2>/dev/null)" ]] || backup >/dev/null   # first change: keep the originals
        asusctl fan-curve --mod-profile "$2" --fan "$3" --data "$4" >/dev/null
        asusctl fan-curve --mod-profile "$2" --enable-fan-curves true >/dev/null
        echo ok ;;
    enable)
        [[ $# -eq 4 && ( "$4" == true || "$4" == false ) ]] || die "usage: asusfan enable PROFILE cpu|gpu true|false"
        valid_profile "$2"; valid_fan "$3"
        asusctl fan-curve --mod-profile "$2" --enable-fan-curves "$4" >/dev/null
        echo ok ;;
    recommended)
        repo=$(cd "$(dirname "$(readlink -f "$0")")/../../../.." && pwd)
        f=$repo/system/hosts/$(cat /etc/hostname)/50-power.user.sh
        [[ -f $f ]] || die "no recommended setup for this computer"
        bash "$f" </dev/null >/dev/null && echo ok ;;
    validate) msg=$(validate "${2:-}") && echo ok || die "$msg" ;;
    backup) backup ;;
    restore) restore "${2:?usage: asusfan restore DIR}" ;;
    sample) sample ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
