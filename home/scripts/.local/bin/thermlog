#!/usr/bin/env bash
# Thermal/power sampler for the ROG Flow X13 (no root needed, never wakes the NVIDIA GPU).
#   thermlog [seconds=120] [label]   samples every 2 s, prints CSV to ~/.local/state/thermlog/
#                                     and a summary line (avg/max) at the end
set -euo pipefail

secs=${1:-120}
label=${2:-$(asusctl profile get 2>/dev/null | awk '/Active profile/{print $3}')}
out="${XDG_STATE_HOME:-$HOME/.local/state}/thermlog"
mkdir -p "$out"
csv="$out/$(date +%Y%m%d-%H%M%S)-${label:-unknown}.csv"

hw() { for h in /sys/class/hwmon/hwmon*; do [[ "$(<"$h/name")" == "$1" ]] && { echo "$h"; return; }; done; }
k10=$(hw k10temp); gpu=$(hw amdgpu); asus=$(hw asus)
cpu_stat() { awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat; }

echo "time,cpu_c,pkg_w,mhz_avg,util_pct,fan_cpu_rpm,fan_gpu_rpm,ac_online" >"$csv"
read -r t0 i0 < <(cpu_stat)
end=$((SECONDS + secs))
while (( SECONDS < end )); do
    sleep 2
    read -r t1 i1 < <(cpu_stat)
    util=$(( (100 * ((t1 - t0) - (i1 - i0))) / ((t1 - t0) > 0 ? (t1 - t0) : 1) ))
    t0=$t1; i0=$i1
    temp=$(( $(<"$k10/temp1_input") / 1000 ))
    pkg=$(awk '{printf "%.1f", $1/1e6}' "$gpu/power1_input")
    mhz=$(awk '{s+=$1; n++} END{printf "%d", s/n/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq)
    f1=$(<"$asus/fan1_input"); f2=$(<"$asus/fan2_input")
    ac=$(cat /sys/class/power_supply/AC*/online 2>/dev/null | head -1)
    echo "$(date +%T),$temp,$pkg,$mhz,$util,$f1,$f2,$ac" >>"$csv"
done

awk -F, -v l="$label" 'NR>1{n++; t+=$2; if($2>tm)tm=$2; p+=$3; if($3>pm)pm=$3; m+=$4; u+=$5; f+=$6; if($6>fm)fm=$6}
    END{printf "%-12s temp avg %.0f max %d °C | pkg avg %.1f max %.1f W | clock avg %d MHz | load avg %.0f%% | cpu fan avg %d max %d rpm (%d samples)\n", l, t/n, tm, p/n, pm, m/n, u/n, f/n, fm, n}' "$csv"
echo "csv: $csv"
