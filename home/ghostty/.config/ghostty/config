# Ghostty: Catppuccin Macchiato (built-in theme), JetBrains Mono with ligatures. The shell's
# Settings > Appearance > theme replaces the colours through theme.conf (included at the end).
theme = Catppuccin Macchiato
font-family = JetBrainsMono Nerd Font
font-size = 11.5
font-feature = calt
font-feature = liga
adjust-cell-height = 12%

# Frosted glass (Hyprland blurs behind it) and roomy, centred padding
background = 0f1017
background-opacity = 0.72
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-decoration = none
unfocused-split-opacity = 0.8

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

shell-integration = fish

# One Ghostty stays running in the background (~55 MB), so new windows open in ~0.2 s instead of
# ~2.5 s. Launchers use `ghostty +new-window`; the first one after login starts it through D-Bus.
quit-after-last-window-closed = false
confirm-close-surface = false
copy-on-select = clipboard

# Written by the shell (Settings > Appearance); the "?" makes it optional
config-file = ?theme.conf
