// Minimal greeting for new fish shells (CachyOS runs fastfetch as fish_greeting).
// Kept under ~50 columns so it survives narrow or resized terminals without wrapping.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "CachyOS_small", "padding": { "top": 1, "right": 3 } },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "title": "blue" },
        "key": { "width": 3 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        "break",
        { "type": "os", "key": "", "format": "{name}" },
        { "type": "kernel", "key": "", "format": "{release}" },
        { "type": "wm", "key": "", "format": "{pretty-name} {version}" },
        { "type": "uptime", "key": "󰅐" },
        { "type": "packages", "key": "󰏖", "format": "{all}" },
        { "type": "memory", "key": "󰍛", "format": "{used} / {total}" },
        { "type": "battery", "key": "󰁹", "format": "{capacity}" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
