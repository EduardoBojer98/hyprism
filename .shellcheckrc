# The installer is one program split over lib/*.sh, modules/*/steps and migrations, all sourced into
# install.sh. shellcheck reads each file alone, so it can't see variables set in another file:
#   SC2034 "appears unused", SC2153 "possible misspelling", SC1090/SC1091 "can't follow source"
disable=SC2034,SC2153,SC1090,SC1091
external-sources=true
